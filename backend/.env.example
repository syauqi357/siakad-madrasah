DATABASE_URL=databasesqlitefile
#DATABASE_URL=siakad.db <-- default
PORT=3210
# default port 3000
FRONTEND_URL_DEV=http://localhost:1245
FRONTEND_URL_PROD=http://localhost:1243
JWT_SECRET=verysecretjwt
ADDRESS_SERVER=http://localhost
# should use IP or use domain instead
# PostgreSQL Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
#
# Steps:
#   1. Install PostgreSQL
#   2. Set password for 'postgres' user during install
#   3. Create database: CREATE DATABASE siakad_madrasah;
#   4. Replace username & password below with your actual credentials
#
# Example: postgresql://postgres:Admin123!@localhost:5432/siakad_madrasah
# ============================================
# Auth — change this to a random secret in production!
# Admin123! -> default password for seeded users
# Environment: development | production
NODE_ENV=production